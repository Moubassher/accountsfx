                        <FontAwesomeIconView glyphName="INBOX" />
                     </graphic>
                  </Button>
                  <Button fx:id="sentMessagesBtn" contentDisplay="RIGHT" mnemonicParsing="false" styleClass="wide-button" text="الرسائل المرسلة">
