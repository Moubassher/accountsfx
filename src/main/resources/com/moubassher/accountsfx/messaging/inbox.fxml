<?xml version="1.0" encoding="UTF-8"?>

<?import com.moubassher.search.SearchBar?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <SearchBar>
         <StackPane.margin>
            <Insets />
         </StackPane.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </SearchBar>
      <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="400.0" prefWidth="600.0" styleClass="root">
         <children>
            <HBox nodeOrientation="RIGHT_TO_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox minWidth="-Infinity" prefHeight="200.0" prefWidth="200.0" styleClass="side_pane">
                     <children>
                        <ToggleButton fx:id="inboxBtn" contentDisplay="RIGHT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="wide-button" text="صندوق الوارد" VBox.vgrow="ALWAYS">
                           <graphic>
                              <FontAwesomeIconView glyphName="INBOX" />
                           </graphic>
                           <toggleGroup>
                              <ToggleGroup fx:id="toggleGroup" />
                           </toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="sentMessagesBtn" contentDisplay="RIGHT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="wide-button" text="الرسائل المرسلة" toggleGroup="$toggleGroup" VBox.vgrow="ALWAYS">
                           <graphic>
                              <FontAwesomeIconView glyphName="UPLOAD" />
                           </graphic>
                        </ToggleButton>
                     </children>
                  </VBox>
                  <ScrollPane fitToHeight="true" fitToWidth="true" maxWidth="-Infinity" pannable="true" prefHeight="200.0" prefWidth="700.0">
                     <content>
                        <VBox fx:id="conversationsPane" spacing="5.0">
                           <children>
                              <fx:include source="message_pane.fxml" />
                              <fx:include source="message_pane.fxml" />
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </HBox>
            <Label text="نظام (Pharma-net) البريدي خاص بشبكة النظام ولا يمكن إرسال أو استقبال رسائل من خارج النظام لأحد مستخدمين الشبكة.">
               <font>
                  <Font size="10.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <StackPane.margin>
            <Insets top="90.0" />
         </StackPane.margin>
      </VBox>
   </children>
</StackPane>
