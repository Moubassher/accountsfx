<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane fx:id="rootTabPane" prefHeight="316.0" prefWidth="700.0" stylesheets="@vibrant_blue.css" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <tabs>
      <Tab text="Active Users">
         <content>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
               <children>
                  <ListView fx:id="accountsListView" prefHeight="200.0" prefWidth="200.0" />
                  <HBox prefWidth="200.0" spacing="10.0">
                     <children>
                        <Button fx:id="createAccountBtn" mnemonicParsing="false" text="Create new" />
                        <Button fx:id="resetPasswordBtn" mnemonicParsing="false" text="Reset Password" />
                        <Button fx:id="refreshAccountsBtn" mnemonicParsing="false" text="Refresh list" />
                        <Button fx:id="deleteSelectedAccountBtn" mnemonicParsing="false" text="Delete Selected" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </content>
      </Tab>
      <Tab fx:id="pendingUsersTab" text="Pending Users">
         <content>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
               <children>
                  <TableView fx:id="accountApprovalTable" maxWidth="700.0" prefHeight="200.0" prefWidth="200.0">
                     <columns>
                        <TableColumn fx:id="userNameCol" minWidth="240.0" prefWidth="240.6667022705078" text="User name" />
                        <TableColumn fx:id="accountTypeCol" minWidth="140.0" prefWidth="23.33331298828125" text="Account type" />
                        <TableColumn fx:id="accountClassCol" minWidth="140.0" prefWidth="45.333404541015625" text="Account Class" />
                        <TableColumn fx:id="approveCol" minWidth="100.0" prefWidth="163.3333740234375" text="Approve" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <HBox prefWidth="200.0" spacing="10.0">
                     <children>
                        <Button fx:id="approveAllBtn" mnemonicParsing="false" text="Approve all" />
                        <Button fx:id="approveSelectedBtn" mnemonicParsing="false" text="Approve selected" />
                        <Button fx:id="denyUnselectedBtn" mnemonicParsing="false" text="Deny Unselected" />
                        <Button fx:id="refreshPendingBtn" mnemonicParsing="false" text="Refresh Pending" />
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </content>
      </Tab>
   </tabs>
</TabPane>
