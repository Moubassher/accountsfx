<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" nodeOrientation="RIGHT_TO_LEFT" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
  <tabs>
    <Tab fx:id="addExpenseTab" text="إضافة منصرف" />
    <Tab fx:id="viewExpensesTab" text="عرض المنصرفات">
         <content>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" styleClass="root">
               <children>
                  <HBox prefWidth="200.0">
                     <children>
                        <Label text="العملة:" />
                        <ChoiceBox fx:id="currencySelector" minWidth="140.0" prefHeight="29.0" prefWidth="106.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="10.0">
                     <children>
                        <Label text="الفترة:" />
                        <Label text="من:" />
                        <DatePicker fx:id="startDate" />
                        <Label text="إلى" />
                        <DatePicker fx:id="endDate" />
                     </children>
                  </HBox>
                  <TableView fx:id="expensesTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity">
                    <columns>
                        <TableColumn fx:id="approveCol" maxWidth="50.0" prefWidth="75.0" text="تحديد" />
                      <TableColumn fx:id="expenseCol" prefWidth="75.0" text="المنصرف" />
                      <TableColumn fx:id="amountCol" maxWidth="200.0" prefWidth="75.0" text="المبلغ" />
                        <TableColumn fx:id="dateCol" maxWidth="120.0" prefWidth="75.0" text="التاريخ" />
                        <TableColumn fx:id="timeCol" maxWidth="120.0" prefWidth="75.0" text="الساعة" />
                        <TableColumn fx:id="madeByCol" maxWidth="170.0" prefWidth="75.0" text="بواسطة" />
                        <TableColumn fx:id="noteCol" prefWidth="75.0" text="ملاحظة" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <HBox prefHeight="89.0" prefWidth="381.0" spacing="10.0">
                     <children>
                        <Button fx:id="approveBtn" defaultButton="true" mnemonicParsing="false" styleClass="primary-btn" text="تصديق" />
                        <Button fx:id="selectAllBtn" mnemonicParsing="false" text="تحديد الكل" />
                        <Button fx:id="unselectAll" mnemonicParsing="false" text="إلغاء الكل" />
                        <Button fx:id="deleteExpenseBtn" contentDisplay="RIGHT" mnemonicParsing="false" styleClass="cancel-btn" text="حذف">
                           <graphic>
                              <FontAwesomeIconView glyphName="TRASH" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </VBox>
         </content>
      </Tab>
  </tabs>
</TabPane>
